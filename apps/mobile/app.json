{
  "expo": {
    "name": "RUINS",
    "slug": "ruins",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.senseify.ruins",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RUINS requires real-time physical location telemetry to track your operative position relative to mission objectives on the tactical map."
      }
    },
    "android": {
      "package": "com.senseify.ruins",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#08090B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RUINS requires location access to verify physical objective proximity on the live tactical map."
        }
      ],
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
