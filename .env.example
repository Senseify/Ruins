# ==============================================================================
# RUINS - Environment Configuration Template
# Copy to .env for local deployment. NEVER commit .env with real credentials.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL 15+ with PostGIS)
# In production, missing DATABASE_URL triggers a fatal startup error.
# MemoryDatabaseStore is strictly permitted for local tests and development only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruins

# JWT Authentication
# In production, JWT_SECRET must be at least 32 characters of high entropy.
JWT_SECRET=ruins_production_secret_must_be_configured_with_32_characters_minimum

# Security & CORS
# In production, set to exact trusted mobile/web domains
CORS_ORIGIN=*

# Realtime WebSocket Configuration
WS_PING_INTERVAL_MS=25000

# Optional: AI Game Master (Phase 15)
# If provided, Gemini generates live narrative briefings. If omitted, procedural intelligence engine is used.
GEMINI_API_KEY=

# Mobile Client API Targets (apps/mobile)
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WS_URL=ws://localhost:3001/ws
